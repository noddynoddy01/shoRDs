# shoRDs Production Environment Configuration Template
# Real values are set in Railway / Vercel dashboards. Never commit a real .env.

# ---- Server ----
PORT=4000
NODE_ENV=production
# Behind Railway's proxy set TRUST_PROXY=true so rate limits see the real client IP (taken from X-Forwarded-For,
# `TRUST_PROXY_HOPS` entries from the right; verify the hop count on the live deployment before relying on IP limits).
TRUST_PROXY=false
TRUST_PROXY_HOPS=1
MAX_REQUEST_BODY_BYTES=524288
# Temporary: set true ONLY while running `node scripts/verify_cloud.js` to learn the right TRUST_PROXY_HOPS; the public
# /api/v1/replica endpoint then adds hashed tags of the caller's own X-Forwarded-For chain. Remove it afterwards.
# NETWORK_DIAGNOSTICS=false

# ---- Required dependencies (a missing one fails /ready and the dependent routes answer 503) ----
# Railway's Postgres and Redis URLs (private network `*.railway.internal` and the TCP proxy) are plain redis:// / postgresql:// -
# use them as supplied; do not rewrite them to rediss://. rediss:// is for external managed Redis (Upstash, Redis Cloud, ...):
# the in-repo client then does a verified TLS handshake (TLSv1.2+, certificate and hostname checked, no skip-verify option).
# If the provider uses a private CA, put its PEM in REDIS_TLS_CA.
DATABASE_URL=postgresql://shords_user:CHANGE_ME@postgres:5432/shords_production
REDIS_URL=redis://redis:6379
# REDIS_TLS_CA=
PG_POOL_MAX=8

# ---- Authentication (Firebase ID tokens, verified server-side) ----
# The Firebase project id the web app signs in against (the token audience). Without it every protected route answers 503.
FIREBASE_PROJECT_ID=
# Set true to also require a verified email address (recommended while sign-up is open).
AUTH_REQUIRE_VERIFIED_EMAIL=false
# Comma-separated Firebase uids allowed to use the admin routes: GET /api/v1/llm/health, GET /api/v1/llm/metrics,
# GET /api/v1/admin/ai/budget and PUT /api/v1/admin/ai/kill-switch. Empty = nobody is an admin.
ADMIN_UIDS=

# ---- CORS: exact origins, comma separated. Never '*'. Unset in production => no browser origin is allowed. ----
CORS_ORIGINS=https://shords.vercel.app
# (development only, when CORS_ORIGINS is unset: localhost / 127.0.0.1 on any port are allowed)

# ---- Rate limits (Redis-backed, shared by all replicas): "<limit>/<windowSeconds>" ----
# Defaults shown. An invalid value stops startup. RATE_LIMIT_FAIL_MODE=closed (default) answers 503 if Redis is down; "open" is an explicit opt-out.
RATE_LIMIT_GLOBAL_IP=300/60
RATE_LIMIT_AUTH_FAIL_IP=20/60
RATE_LIMIT_READ_USER=240/60
RATE_LIMIT_WRITE_USER=30/60
RATE_LIMIT_COPILOT_USER=20/60
RATE_LIMIT_COPILOT_USER_DAILY=400/86400
RATE_LIMIT_COPILOT_TENANT=120/60
RATE_LIMIT_COPILOT_TENANT_DAILY=2000/86400
RATE_LIMIT_ANALYSIS_USER=10/60
RATE_LIMIT_ANALYSIS_USER_DAILY=100/86400
RATE_LIMIT_ANALYSIS_TENANT=60/60
RATE_LIMIT_ANALYSIS_TENANT_DAILY=1000/86400
RATE_LIMIT_FAIL_MODE=closed
# Community (profiles, mentorship, messaging, notifications) and the shoRDs Assistant. Defaults shown.
RATE_LIMIT_PROFILE_WRITE_USER=20/60
RATE_LIMIT_MENTOR_APPLY_USER=5/3600
RATE_LIMIT_MENTOR_REQUEST_USER=10/3600
RATE_LIMIT_MENTORSHIP_ACTION_USER=30/60
RATE_LIMIT_CONVERSATION_CREATE_USER=20/3600
RATE_LIMIT_MESSAGE_SEND_USER=30/60
RATE_LIMIT_REPORT_USER=10/3600
RATE_LIMIT_ADMIN_USER=60/60
RATE_LIMIT_ASSISTANT_USER=10/60
RATE_LIMIT_ASSISTANT_USER_DAILY=100/86400

# ---- Paper retrieval (OpenAlex / Europe PMC / Unpaywall; sources are public, results are cached by coverage) ----
# A contact address sent to the scholarly APIs (polite pool). Use a monitored mailbox.
CONTACT_EMAIL=
RATE_LIMIT_RETRIEVAL_USER=30/60
RATE_LIMIT_RETRIEVAL_USER_DAILY=600/86400
# Global ceiling on outbound scholarly-provider calls from all replicas together.
RATE_LIMIT_RETRIEVAL_PROVIDERS=240/60
# Upper bound on paper text (characters) handed to the model per request (default 120000, minimum 2000).
AI_MAX_CONTEXT_CHARS=

# ---- Analysis jobs (PostgreSQL state + Redis queue + worker inside every replica) ----
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
JOB_LEASE_SEC=120

# ---- Result cache / de-duplication (Redis) ----
AI_CACHE_ENABLED=true
AI_CACHE_TTL_SEC=86400

# ---- AI provider ----
# Claude model; defaults to claude-sonnet-5-5 when unset. Retired IDs (e.g. claude-3-5-sonnet-20241022) are ignored.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Server-side only; leave EMPTY until the pre-key hardening is accepted, then set it ONLY in the Railway dashboard.
ANTHROPIC_API_KEY=
# true => /ready fails while the provider is unreachable (default false: replicas stay ready and serve the labelled local fallback)
REQUIRE_AI_PROVIDER=false
# Optional price override, USD per million tokens, used by the spend gate and by cost reporting. Leave BOTH out (or both empty) to
# use the built-in price table; a model with no built-in price is then refused (fail closed).
# When you set it, set BOTH to positive decimal numbers (for example 3 and 15): the pair then replaces the price of EVERY model, the
# built-in ones included, not only unknown models. It does not switch cost control off: 0, negative, non-numeric or only one of the
# two stops the server at startup, and the daily and per-request ceilings are always computed from a real, positive price.
# There is no minimum price: the unit is micro-USD (USD per million tokens = micro-USD per token) and every call is charged in whole
# micro-USD, rounded UP, so a very small price still costs at least 1 micro-USD per call and the ceilings still fill. Below 1 USD per
# million tokens that rounding over-counts by under 1 micro-USD per call. A price so large that one request's worst case is not an
# exactly representable amount (roughly 6 billion USD per million tokens for the largest request) is refused per request, not applied.
# The two lines below are examples, not defaults - leave them commented out unless you mean to override every model's price.
# ANTHROPIC_PRICE_INPUT_PER_MTOK=3
# ANTHROPIC_PRICE_OUTPUT_PER_MTOK=15

# ---- AI spend gate (backend/llm/aiBudget.js; runbook: docs/architecture/AI_SPEND_SAFETY.md) ----
# Every value below is OPTIONAL and commented out: the value shown is what the code uses when the variable is unset or empty.
# They are engineering placeholders, not business decisions - the owner must review them. A malformed value stops startup.
# Kill switch: true/1/yes/on or false/0/no/off. An unrecognised value DISABLES paid calls (fail closed). false cannot be re-opened from Redis.
# AI_ENABLED=true
# enforce = refuse over-budget calls; observe = record only (use it to measure, never as a permanent setting)
# AI_BUDGET_MODE=enforce
# Daily ceilings in USD per UTC day ("unlimited" lifts one). A request with no project is charged no project budget (it is
# still bound by the global, tenant and user limits).
# AI_BUDGET_GLOBAL_DAILY_USD=25
# AI_BUDGET_TENANT_DAILY_USD=5
# AI_BUDGET_PROJECT_DAILY_USD=2
# AI_BUDGET_USER_DAILY_USD=2
# Worst-case cost of one request, computed from the two bounds below.
# AI_BUDGET_REQUEST_MAX_USD=1.25
# AI_REQUEST_MAX_OUTPUT_TOKENS=32000
# AI_REQUEST_MAX_INPUT_TOKENS_BOUND=600000
# Optional daily call-count caps (unset = no cap): AI_BUDGET_{GLOBAL,TENANT,PROJECT,USER}_DAILY_CALLS
# Concurrent paid calls (defaults 16 / 6 / unset / 2) and how long a call waits for a free slot before it is refused (0 = refuse at once).
# AI_BUDGET_GLOBAL_MAX_CONCURRENT=16
# AI_BUDGET_TENANT_MAX_CONCURRENT=6
# AI_BUDGET_PROJECT_MAX_CONCURRENT=
# AI_BUDGET_USER_MAX_CONCURRENT=2
# AI_CONCURRENCY_WAIT_MS=10000
# Provider retries (integer 0-3) and the circuit breaker (consecutive failures, cooldown seconds, cooldown after a credential/credit error).
# AI_MAX_PROVIDER_RETRIES=1
# AI_BREAKER_FAILURES=5
# AI_BREAKER_COOLDOWN_SEC=30
# AI_BREAKER_CREDENTIAL_COOLDOWN_SEC=300
# Readiness: how long (seconds, minimum 5) a provider reachability probe is reused.
# AI_PROBE_TTL_SEC=60

# ---- Legacy / TypeScript gateway (not read by the production entrypoint) ----
LLM_PROVIDER=anthropic
LLM_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_TIMEOUT_MS=120000
LLM_MAX_RETRIES=3
LLM_COST_CONTROL_ENABLED=true
LLM_FALLBACK_ENABLED=true
LLM_CACHE_ENABLED=true

# ---- Frontend build (Vercel / Expo; public by design, these are NOT secrets) ----
# Firebase web config for the SAME project as FIREBASE_PROJECT_ID. Without these the app shows "sign-in not configured".
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Origin of the Railway backend (https required except for localhost). The backend's CORS_ORIGINS must list the Vercel
# origin this app is served from; this variable is the backend's own address, not a CORS entry.
EXPO_PUBLIC_API_URL=

# ---- Benchmark-only raw model output capture (LOCAL machines only; leave both UNSET everywhere else) ----
# Keeps the model's unvalidated output and the chunks it was given, in separate local files, for the F1 manual review. Off unless BOTH are set.
# The process refuses to start with it on when NODE_ENV=production or any RAILWAY_*/VERCEL/KUBERNETES_SERVICE_HOST variable is present, and no
# request can switch it on. The files hold paper text and model output: never commit them, never put them in a log or a database.
# See docs/ops/BENCHMARK_PREPARATION_2026-11-04.md.
BENCHMARK_RAW_CAPTURE=
BENCHMARK_RAW_CAPTURE_DIR=

# Optional public site details shown in the landing-page footer. Public values only. Anything left empty is not displayed.
EXPO_PUBLIC_CONTACT_EMAIL=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SOCIAL_GITHUB=
EXPO_PUBLIC_SOCIAL_LINKEDIN=
EXPO_PUBLIC_SOCIAL_X=
