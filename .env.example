# shoRDs Production Environment Configuration Template
# Server & Security
PORT=4000
NODE_ENV=production
SESSION_SECRET=REPLACE_WITH_A_64_CHARACTER_RANDOM_HEX_SECRET

# Database & Cache
DATABASE_URL=postgresql://shords_user:shords_secure_password@postgres:5432/shords_production
REDIS_URL=redis://redis:6379

# AI Gateway & LLM Providers (anthropic | openai | gemini | local_deterministic)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-20241022

# Provider API Credentials (server-side only, never committed or exposed)
LLM_API_KEY=REPLACE_WITH_YOUR_PRIMARY_API_KEY
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Resilience, Caching & Budget Controls
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=3
LLM_COST_CONTROL_ENABLED=true
LLM_FALLBACK_ENABLED=true
LLM_CACHE_ENABLED=true
