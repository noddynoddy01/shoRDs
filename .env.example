# shoRDs Production Environment Configuration Template
# Real values are set in Railway / Vercel dashboards. Never commit a real .env.

# ---- Server ----
PORT=4000
NODE_ENV=production
# Behind Railway's proxy set TRUST_PROXY=true so rate limits see the real client IP (taken from X-Forwarded-For,
# `TRUST_PROXY_HOPS` entries from the right; verify the hop count on the live deployment before relying on IP limits).
TRUST_PROXY=false
TRUST_PROXY_HOPS=1
MAX_REQUEST_BODY_BYTES=524288
# Temporary: set true ONLY while running `node scripts/verify_cloud.js` to learn the right TRUST_PROXY_HOPS; the public
# /api/v1/replica endpoint then adds hashed tags of the caller's own X-Forwarded-For chain. Remove it afterwards.
# NETWORK_DIAGNOSTICS=false

# ---- Required dependencies (a missing one fails /ready and the dependent routes answer 503) ----
# Railway's Postgres and Redis URLs (private network `*.railway.internal` and the TCP proxy) are plain redis:// / postgresql:// -
# use them as supplied; do not rewrite them to rediss://. rediss:// is for external managed Redis (Upstash, Redis Cloud, ...):
# the in-repo client then does a verified TLS handshake (TLSv1.2+, certificate and hostname checked, no skip-verify option).
# If the provider uses a private CA, put its PEM in REDIS_TLS_CA.
DATABASE_URL=postgresql://shords_user:CHANGE_ME@postgres:5432/shords_production
REDIS_URL=redis://redis:6379
# REDIS_TLS_CA=
PG_POOL_MAX=8

# ---- Authentication (Firebase ID tokens, verified server-side) ----
# The Firebase project id the web app signs in against (the token audience). Without it every protected route answers 503.
FIREBASE_PROJECT_ID=
# Set true to also require a verified email address (recommended while sign-up is open).
AUTH_REQUIRE_VERIFIED_EMAIL=false
# Comma-separated Firebase uids allowed to read /api/v1/llm/health and /api/v1/llm/metrics.
ADMIN_UIDS=

# ---- CORS: exact origins, comma separated. Never '*'. Unset in production => no browser origin is allowed. ----
CORS_ORIGINS=https://shords.vercel.app
# (development only, when CORS_ORIGINS is unset: localhost / 127.0.0.1 on any port are allowed)

# ---- Rate limits (Redis-backed, shared by all replicas): "<limit>/<windowSeconds>" ----
# Defaults shown. An invalid value stops startup. RATE_LIMIT_FAIL_MODE=closed (default) answers 503 if Redis is down; "open" is an explicit opt-out.
RATE_LIMIT_GLOBAL_IP=300/60
RATE_LIMIT_AUTH_FAIL_IP=20/60
RATE_LIMIT_READ_USER=240/60
RATE_LIMIT_WRITE_USER=30/60
RATE_LIMIT_COPILOT_USER=20/60
RATE_LIMIT_COPILOT_USER_DAILY=400/86400
RATE_LIMIT_COPILOT_TENANT=120/60
RATE_LIMIT_COPILOT_TENANT_DAILY=2000/86400
RATE_LIMIT_ANALYSIS_USER=10/60
RATE_LIMIT_ANALYSIS_USER_DAILY=100/86400
RATE_LIMIT_ANALYSIS_TENANT=60/60
RATE_LIMIT_ANALYSIS_TENANT_DAILY=1000/86400
RATE_LIMIT_FAIL_MODE=closed

# ---- Paper retrieval (OpenAlex / Europe PMC / Unpaywall; sources are public, results are cached by coverage) ----
# A contact address sent to the scholarly APIs (polite pool). Use a monitored mailbox.
CONTACT_EMAIL=
RATE_LIMIT_RETRIEVAL_USER=30/60
RATE_LIMIT_RETRIEVAL_USER_DAILY=600/86400
# Global ceiling on outbound scholarly-provider calls from all replicas together.
RATE_LIMIT_RETRIEVAL_PROVIDERS=240/60
# Upper bound on paper text (characters) handed to the model per request.
AI_MAX_CONTEXT_CHARS=

# ---- Analysis jobs (PostgreSQL state + Redis queue + worker inside every replica) ----
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
JOB_LEASE_SEC=120

# ---- Result cache / de-duplication (Redis) ----
AI_CACHE_ENABLED=true
AI_CACHE_TTL_SEC=86400

# ---- AI provider ----
# Claude model; defaults to claude-sonnet-5-5 when unset. Retired IDs (e.g. claude-3-5-sonnet-20241022) are ignored.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Server-side only; leave EMPTY until the pre-key hardening is accepted, then set it ONLY in the Railway dashboard.
ANTHROPIC_API_KEY=
# true => /ready fails while the provider is unreachable (default false: replicas stay ready and serve the labelled local fallback)
REQUIRE_AI_PROVIDER=false

# ---- Legacy / TypeScript gateway (not read by the production entrypoint) ----
LLM_PROVIDER=anthropic
LLM_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_TIMEOUT_MS=120000
LLM_MAX_RETRIES=3
LLM_COST_CONTROL_ENABLED=true
LLM_FALLBACK_ENABLED=true
LLM_CACHE_ENABLED=true

# ---- Frontend build (Vercel / Expo; public by design, these are NOT secrets) ----
# Firebase web config for the SAME project as FIREBASE_PROJECT_ID. Without these the app shows "sign-in not configured".
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Origin of the Railway backend (https required except for localhost). The backend's CORS_ORIGINS must list the Vercel
# origin this app is served from; this variable is the backend's own address, not a CORS entry.
EXPO_PUBLIC_API_URL=
